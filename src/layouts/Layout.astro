---
const { title } = Astro.props;
// Load projects for the sidebar menu and sort them by order
const artFiles = Object.entries(import.meta.glob('../content/art/*.md', { eager: true }))
  .sort(([, a], [, b]) => (a.frontmatter.order || 99) - (b.frontmatter.order || 99));
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    
  </head>

  <body>
    <div class="layout-wrapper">

      <!-- Left Sidebar -->
      <aside class="sidebar">
        <div class="sidebar-top">
          
          <h1 class="site-title">
            <a href="/" class="home-link">Eliza Tremzina</a>
          </h1>

          <nav class="top-nav-menu">
            <!-- Interactive About block -->
            <div class="menu-accordion" id="about-wrapper">
              <button class="nav-link toggle-btn" id="about-toggle">About</button>
              <div class="dropdown-content about-description">
                <p>Hello! I am a multidisciplinary designer focusing on speculative design, brand identity, and motion graphics.</p>
              </div>
            </div>

            <!-- Interactive Works block -->
            <div class="menu-accordion" id="works-wrapper">
              <button class="nav-link toggle-btn" id="works-toggle">Works</button>
              <div class="dropdown-content works-list">
                {artFiles.map(([path, file]) => {
                  const art = file.frontmatter;
                  const slug = path.split('/').pop().replace('.md', '');
                  const category = art.skills ? art.skills.split(',')[0] : 'Project';

                  return (
                    <a href={`/art/${slug}`} class="small-project-tile">
                      <div class="small-image-container">
                        <img src={art.image} alt={art.title} class="small-tile-img" loading="lazy" />
                      </div>
                      <span class="small-tile-text">{category}</span>
                    </a>
                  );
                })}
              </div>
            </div>
          </nav>
        </div>

        <!-- Desktop Socials (Hidden on mobile) -->
        <div class="socials-block desktop-socials">
          <button class="social-link copy-email-btn" data-email="eliza.tremzina@gmail.com">Email</button>
          <a href="https://www.instagram.com/elizas.palette" class="social-link" target="_blank" rel="noopener noreferrer">Instagram</a>
          <a href="https://www.linkedin.com/in/eliza-tremzina-226715272/" class="social-link" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        </div>
      </aside>

      <!-- Right Content -->
      <main class="content">
        <slot />

        <!-- Mobile Socials (Hidden on desktop) -->
        <div class="socials-block mobile-socials">
          <button class="social-link copy-email-btn" data-email="eliza.tremzina@gmail.com">Email</button>
          <a href="https://www.instagram.com/elizas.palette" class="social-link" target="_blank" rel="noopener noreferrer">Instagram</a>
          <a href="https://www.linkedin.com/in/eliza-tremzina-226715272/" class="social-link" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        </div>
      </main>

    </div>

    <!-- Script to toggle dropdown menus & handle email copy -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        // Reusable function for accordion menus
        const initAccordion = (triggerId, wrapperId, siblingWrapperId) => {
          const trigger = document.getElementById(triggerId);
          const wrapper = document.getElementById(wrapperId);
          const siblingWrapper = document.getElementById(siblingWrapperId);

          if (trigger && wrapper) {
            trigger.addEventListener('click', () => {
              wrapper.classList.toggle('is-open');
              if (siblingWrapper) siblingWrapper.classList.remove('is-open');
            });
          }
        };

        // Initialize both menus
        initAccordion('about-toggle', 'about-wrapper', 'works-wrapper');
        initAccordion('works-toggle', 'works-wrapper', 'about-wrapper');

        // Email copy & redirect logic
        const emailBtns = document.querySelectorAll('.copy-email-btn');
        
        emailBtns.forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            const email = btn.getAttribute('data-email');
            
            // 1. Open the default mail client
            window.location.href = `mailto:${email}`;
            
            // 2. Simultaneously copy the email to the clipboard
            navigator.clipboard.writeText(email).then(() => {
              const originalText = btn.innerText;
              btn.innerText = 'Copied!'; 
              
              // Restore the original text after 2 seconds
              setTimeout(() => {
                btn.innerText = originalText;
              }, 2000);
            });
          });
        });
      });
    </script>
  </body>
</html>

<style is:global>
  /* --- CUSTOM FONTS --- */
  
  /* Sora */
  @font-face {
    font-family: 'Sora';
    src: url('/fonts/Sora-VariableFont_wght.ttf') format('truetype');
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }

  /* Young Serif  */
  @font-face {
    font-family: 'Young Serif';
    src: url('/fonts/YoungSerif-Regular.ttf') format('truetype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  
  /* --- GLOBAL STYLES --- */
  body {
    background: #FFFBF1;
    margin: 0;
    font-family: 'Sora', sans-serif;
    color: #120E00;
  }

  /* --- 1. MOBILE-FIRST LAYOUT --- */
  .layout-wrapper {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .sidebar {
    width: 100%;
    padding: 20px;
    background: #FFFBF1;
    position: sticky;
    top: 0;
    z-index: 100;
    box-sizing: border-box;
  }

  .sidebar-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .site-title {
    font-family: 'Young Serif', serif;
    font-size: clamp(22px, 1.35vw, 26px);
    margin: 0;
    line-height: 95%;
  }

  .home-link {
    color: inherit;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .home-link:hover {
    opacity: 0.7;
  }

  .top-nav-menu {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 15px;
  }

  .nav-link {
    font-family: 'Sora', sans-serif;
    font-size: clamp(14px, 0.94vw, 18px);
    color: inherit;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .nav-link:hover {
    opacity: 0.6;
  }

  /* --- Dropdown Menus --- */
  .menu-accordion {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
    width: 100%;
  }

  .toggle-btn {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font-family: inherit;
    font-size: inherit;
    color: inherit;
  }

  .dropdown-content {
    display: none;
  }

  .menu-accordion.is-open .dropdown-content {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
  }

  .menu-accordion.is-open .toggle-btn {
    font-weight: 600;
  }

  .about-description {
    width: 100%;
    max-width: 200px;
    font-size: clamp(12px, 0.73vw, 14px);
    line-height: 1.3;
    text-align: right;
  }

  .about-description p { margin: 0; }

  /* --- Works Mini-Cards --- */
  .works-list {
    width: 100%;
    max-width: 240px; 
  }

  .small-project-tile {
    display: flex;
    align-items: center;
    padding: 10px;
    gap: 10px;
    width: 100%;
    box-sizing: border-box;
    border: 1.5px solid #120E00;
    border-radius: 15px;
    text-decoration: none;
    color: inherit;
    transition: background-color 0.2s ease;
  }

  .small-project-tile:hover {
    background-color: rgba(18, 14, 0, 0.05); 
  }

  .small-image-container {
    width: clamp(50px, 3.65vw, 70px);
    height: clamp(60px, 4.38vw, 84px);
    border-radius: 10px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .small-tile-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .small-tile-text {
    font-family: 'Sora', sans-serif;
    font-size: clamp(12px, 0.7vw, 13.5px);
    line-height: 1.25;
    text-transform: capitalize;
  }

  .content {
    width: 100%;
    padding: 20px;
    box-sizing: border-box; 
  }

  /* --- Socials --- */
  .socials-block {
    display: flex;
    gap: 15px;
  }

  .social-link {
    font-family: 'Sora', sans-serif;
    font-size: clamp(14px, 0.94vw, 18px);
    text-decoration: underline;
    color: inherit;
    transition: opacity 0.2s;
  }

  .social-link:hover {
    opacity: 0.6;
  }

  .desktop-socials {
    display: none; 
  }

  .copy-email-btn {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-align: left;
    line-height: inherit; 
  }

  .mobile-socials {
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 60px;
    padding-top: 20px;
    border-top: 1px solid rgba(18, 14, 0, 0.1);
  }

  /* --- 2. DESKTOP VERSION (min-width: 768px) --- */
  @media (min-width: 768px) {
    .layout-wrapper {
      display: grid;
      grid-template-columns: clamp(240px, 15.93vw, 306px) 1fr;
    }
    
    .sidebar {
      height: 100vh;
      padding: clamp(20px, 2.08vw, 40px); 
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .sidebar-top {
      flex-direction: column; 
      gap: 30px;
    }

    .top-nav-menu, .menu-accordion {
      align-items: flex-start;
    }

    .toggle-btn, .about-description {
      text-align: left;
    }

    .content {
      padding: clamp(20px, 2.08vw, 40px);
    }

    .mobile-socials {
      display: none; 
    }

    .desktop-socials {
      display: flex;
      flex-direction: column;
    }
  }
</style>